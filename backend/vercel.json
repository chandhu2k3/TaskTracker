{
  "version": 2,
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[a].js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[a]/[b].js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[a]/[b]/[c].js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[a]/[b]/[c]/[d].js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[a]/[b]/[c]/[d]/[e].js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/[a]/[b]/[c]/[d]/[e]/[f].js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Connection",
          "value": "keep-alive"
        },
        {
          "key": "Keep-Alive",
          "value": "timeout=60, max=1000"
        }
      ]
    }
  ]
}
